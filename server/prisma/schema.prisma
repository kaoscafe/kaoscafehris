// ============================================================================
// KAOS Cafe HRIS — Prisma Schema
// Multi-branch Human Resource Information System
// Stack: PostgreSQL + Prisma ORM
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  TRAINEE
  FULL_TIME
  PART_TIME
  RESERVED
  TERMINATED
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum SyncStatus {
  PENDING // recorded offline, not yet synced
  SYNCED  // successfully synced to server
  FAILED  // sync attempted but failed
}

enum AttendanceSource {
  KIOSK  // recorded via selfie kiosk or offline sync
  MANUAL // created by admin/manager through the portal
  AUTO   // system-generated (e.g. auto-absent cron job)
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  FINALIZED
}

enum DeductionType {
  LATE           // auto-computed from attendance
  UNPAID_LEAVE   // auto-computed from approved unpaid leave requests
  CASH_ADVANCE
  SALARY_LOAN
  SSS
  PHILHEALTH
  PAGIBIG
  BIR_TAX        // withholding tax
  OTHER
}

enum EarningType {
  OVERTIME
  BONUS
  ALLOWANCE
  HOLIDAY_PAY
  PAID_LEAVE        // credited for hourly employees on approved paid leave days
  NIGHT_DIFFERENTIAL
  OTHER
}

enum PayType {
  MONTHLY_FIXED
  HOURLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt-hashed
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  lastLogin DateTime?

  employee  Employee?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================================================
// BRANCH MANAGEMENT
// ============================================================================

model Branch {
  id             String  @id @default(uuid())
  name           String  @unique
  address        String
  city           String
  phone          String?
  branchManager  String?
  operatingHours String?
  isActive       Boolean @default(true)

  employees              Employee[]
  shifts                 Shift[]
  attendanceRecords      Attendance[]
  payrollRuns            PayrollRun[]
  shiftAssignmentOverrides ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// ============================================================================
// EMPLOYEE MANAGEMENT
// ============================================================================

model Employee {
  id               String           @id @default(uuid())
  employeeId       String           @unique // human-readable ID (e.g., KAOS-0001)
  userId           String           @unique
  branchId         String

  // Personal info
  firstName        String
  lastName         String
  middleName       String?
  dateOfBirth      DateTime?
  gender           String?
  civilStatus      String?
  nationality      String?          @default("Filipino")
  profilePhoto     String?          // URL to profile image

  // Contact
  phone            String?
  address          String?
  city             String?
  province         String?
  zipCode          String?

  // Emergency contact
  emergencyName    String?
  emergencyPhone   String?
  emergencyRelation String?

  // Employment details
  position         String
  employmentStatus EmploymentStatus @default(FULL_TIME)
  dateHired        DateTime
  dateTerminated   DateTime?
  payType          PayType          @default(MONTHLY_FIXED)
  basicSalary      Decimal          @default(0) @db.Decimal(12, 2) // monthly basic salary (used when payType = MONTHLY_FIXED)
  hourlyRate       Decimal?         @db.Decimal(12, 4)             // used when payType = HOURLY
  defaultShiftTypeId String?        // default shift template for this employee

  // Government IDs — used for payroll deductions
  sssNumber        String?
  philhealthNumber String?
  pagibigNumber    String?
  tinNumber        String?          // BIR Tax Identification Number

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch           Branch           @relation(fields: [branchId], references: [id])
  defaultShiftType ShiftType?       @relation(fields: [defaultShiftTypeId], references: [id], onDelete: SetNull)

  shiftAssignments    ShiftAssignment[]
  attendanceRecords   Attendance[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  payslips            Payslip[]
  overtimeRequests    OvertimeRequest[]
  overtimeSchedules   OvertimeSchedule[]
  employeeDeductions  EmployeeDeduction[]
  employeeEarnings    EmployeeEarning[]
  documents           EmployeeDocument[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([branchId])
  @@index([employmentStatus])
  @@map("employees")
}

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  name         String   // user-provided label (e.g. "NBI Clearance")
  filename     String   // stored filename on disk (UUID.ext)
  originalName String   // original uploaded filename
  mimeType     String
  size         Int      // file size in bytes
  uploadedAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

// ============================================================================
// SHIFT SCHEDULING
// ============================================================================

model ShiftType {
  id             String   @id @default(uuid())
  name           String   @unique
  startTime      DateTime @db.Time()
  endTime        DateTime @db.Time()
  breakDuration  Int      @default(60) // break time in minutes (excluded from paid hours)
  isActive       Boolean  @default(true)

  shifts               Shift[]
  employeesWithDefault Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shift_types")
}


model Shift {
  id         String       @id @default(uuid())
  branchId   String
  shiftTypeId String?      // optional: if set, inherits times from ShiftType
  name       String       // e.g., "Morning Shift", "Closing Shift"
  date       DateTime     @db.Date
  startTime  DateTime     @db.Time()
  endTime    DateTime     @db.Time()
  status     ShiftStatus  @default(DRAFT)

  branch      Branch           @relation(fields: [branchId], references: [id])
  shiftType   ShiftType?       @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)
  assignments ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, date])
  @@index([shiftTypeId])
  @@map("shifts")
}

model ShiftAssignment {
  id         String @id @default(uuid())
  shiftId    String
  employeeId String

  // Override branch for this specific assignment (null = use shift.branchId)
  assignedBranchId String?

  // Overtime decision (set by manager/admin from adjust-attendance dialog)
  overtimeApproved   Boolean  @default(false)
  overtimeRejected   Boolean  @default(false)
  overtimeApprovedBy String?  // userId of the approver/rejecter

  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id])
  assignedBranch Branch?  @relation(fields: [assignedBranchId], references: [id])

  createdAt DateTime @default(now())

  @@unique([shiftId, employeeId])
  @@index([employeeId])
  @@index([assignedBranchId])
  @@map("shift_assignments")
}

// Employee-submitted overtime request (manager/admin can approve or reject)
model OvertimeRequest {
  id         String         @id @default(uuid())
  employeeId String
  shiftId    String?        // optional link to a specific shift
  date       DateTime       @db.Date
  startTime  String?        // HH:MM
  endTime    String?        // HH:MM
  reason     String
  status     OvertimeStatus @default(PENDING)
  otHours    Decimal?       @db.Decimal(5, 2)

  reviewedBy  String?       // userId
  reviewedAt  DateTime?
  reviewNotes String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([date])
  @@map("overtime_requests")
}

// Admin/manager pre-assigned overtime schedule
model OvertimeSchedule {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @db.Date
  startTime  String   // HH:MM
  endTime    String   // HH:MM
  notes      String?
  otHours    Decimal? @db.Decimal(5, 2)

  createdById String  // userId of admin/manager who created it

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("overtime_schedules")
}

// ============================================================================
// ATTENDANCE (selfie-based kiosk, supports offline sync)
// ============================================================================

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  branchId   String
  date       DateTime         @db.Date

  clockIn    DateTime
  clockOut   DateTime?
  status     AttendanceStatus @default(PRESENT)

  // Selfie verification
  selfieIn   String?          // URL/path to check-in selfie
  selfieOut  String?          // URL/path to check-out selfie

  source       AttendanceSource @default(KIOSK)

  // Offline sync tracking
  syncStatus   SyncStatus     @default(SYNCED)
  deviceId     String?        // identifies the kiosk/tablet
  localRecordId String?       // client-side ID for dedup during sync

  // Computed after clock-out
  hoursWorked    Decimal?     @db.Decimal(5, 2)
  overtimeHours  Decimal?     @db.Decimal(5, 2)
  lateMinutes    Int?         // minutes late vs. scheduled start
  undertimeMinutes Int?       // minutes left early vs. scheduled end

  remarks      String?
  clockInNote  String?  // employee-entered note at clock-in
  clockOutNote String?  // employee-entered note explaining early/late clock-out

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No unique([employeeId, date]) — employees with 2 shifts on the same day
  // can have 2 records. The service layer caps records at scheduled shift count.
  @@index([employeeId, date])
  @@index([branchId, date])
  @@index([syncStatus])
  @@map("attendance_records")
}

// ============================================================================
// LEAVE MANAGEMENT
// ============================================================================

model LeaveRequest {
  id          String      @id @default(uuid())
  employeeId  String
  leaveType   LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Decimal     @db.Decimal(4, 1) // supports half-day (e.g., 0.5)
  reason      String?
  status      LeaveStatus @default(PENDING)

  reviewedBy  String?     // userId of approver
  reviewedAt  DateTime?
  reviewNotes String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  leaveType   LeaveType
  year        Int       // calendar year this balance applies to
  totalDays   Decimal   @db.Decimal(4, 1) // allocated days
  usedDays    Decimal   @db.Decimal(4, 1) @default(0)
  remainingDays Decimal @db.Decimal(4, 1) // computed: totalDays - usedDays

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

// ============================================================================
// PAYROLL PROCESSING (bi-monthly)
// ============================================================================

model PayrollRun {
  id          String        @id @default(uuid())
  branchId    String
  periodStart DateTime      @db.Date // e.g., 1st or 16th of month
  periodEnd   DateTime      @db.Date // e.g., 15th or last day of month
  status      PayrollStatus @default(DRAFT)
  processedBy String?       // userId who ran payroll
  processedAt DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, periodStart, periodEnd])
  @@index([branchId])
  @@map("payroll_runs")
}

model Payslip {
  id            String        @id @default(uuid())
  payrollRunId  String
  employeeId    String

  // Earnings
  basicPay      Decimal       @db.Decimal(12, 2) // prorated basic for the period
  overtimePay   Decimal       @db.Decimal(12, 2) @default(0)
  bonuses       Decimal       @db.Decimal(12, 2) @default(0)
  allowances    Decimal       @db.Decimal(12, 2) @default(0)
  holidayPay    Decimal       @db.Decimal(12, 2) @default(0)
  paidLeaveCredits Decimal    @db.Decimal(12, 2) @default(0)
  grossPay      Decimal       @db.Decimal(12, 2)

  // Government deductions
  sssContribution       Decimal @db.Decimal(12, 2) @default(0)
  philhealthContribution Decimal @db.Decimal(12, 2) @default(0)
  pagibigContribution   Decimal @db.Decimal(12, 2) @default(0)
  withholdingTax        Decimal @db.Decimal(12, 2) @default(0)

  // Other deductions
  lateDeductions        Decimal   @db.Decimal(12, 2) @default(0)
  unpaidLeaveDeductions Decimal   @db.Decimal(12, 2) @default(0)
  cashAdvance           Decimal   @db.Decimal(12, 2) @default(0)
  salaryLoan            Decimal   @db.Decimal(12, 2) @default(0)
  otherDeductions       Decimal   @db.Decimal(12, 2) @default(0)

  totalDeductions   Decimal   @db.Decimal(12, 2)
  netPay            Decimal   @db.Decimal(12, 2)

  // Attendance summary used for pay computation — stored for auditability.
  totalHoursWorked     Decimal @db.Decimal(8, 2) @default(0)
  totalScheduledHours  Decimal @db.Decimal(8, 2) @default(0)
  totalOtHours         Decimal @db.Decimal(8, 2) @default(0)
  totalLateMinutes     Int     @default(0)

  status            PayslipStatus @default(DRAFT)
  pdfUrl            String?       // generated payslip PDF path

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  // Itemized breakdown stored separately for flexibility
  deductions PayslipDeduction[]
  earnings   PayslipEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, employeeId]) // one payslip per employee per run
  @@index([employeeId])
  @@map("payslips")
}

model PayslipDeduction {
  id        String        @id @default(uuid())
  payslipId String
  type      DeductionType
  label     String        // display name, e.g., "SSS Contribution"
  amount    Decimal       @db.Decimal(12, 2)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("payslip_deductions")
}

model PayslipEarning {
  id        String      @id @default(uuid())
  payslipId String
  type      EarningType
  label     String      // display name, e.g., "Overtime (8 hrs)"
  amount    Decimal     @db.Decimal(12, 2)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
  @@map("payslip_earnings")
}

// ============================================================================
// SYSTEM SETTINGS & COMPANY CONFIG
// ============================================================================

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique // e.g., "overtime_rate_multiplier", "sss_table_version"
  value String          // JSON-encoded value for flexibility
  group String?         // grouping: "payroll", "attendance", "company", etc.

  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model GovernmentTable {
  id         String   @id @default(uuid())
  type       String   // "SSS", "PHILHEALTH", "PAGIBIG", "BIR"
  rangeFrom  Decimal  @db.Decimal(12, 2) // salary bracket lower bound
  rangeTo    Decimal  @db.Decimal(12, 2) // salary bracket upper bound
  employeeShare Decimal @db.Decimal(12, 2)
  employerShare Decimal @db.Decimal(12, 2)
  effectiveDate DateTime @db.Date // when this rate schedule takes effect

  @@index([type, effectiveDate])
  @@map("government_tables")
}

// ============================================================================
// DEDUCTIONS
// ============================================================================

model Deduction {
  id        String   @id @default(uuid())
  type      String?  // "SSS" | "PHILHEALTH" | "PAGIBIG" | "BIR_TAX" | null
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeDeductions EmployeeDeduction[]

  @@map("deductions")
}

model EmployeeDeduction {
  id           String   @id @default(uuid())
  employeeId   String
  deductionId  String

  amount       Decimal? @db.Decimal(12, 2) // per-payroll override; null = use Deduction.amount
  totalBalance Decimal? @db.Decimal(12, 2) // null = recurring (no end); set = tracks payoff
  paidAmount   Decimal  @db.Decimal(12, 2) @default(0)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deduction Deduction @relation(fields: [deductionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, deductionId])
  @@index([employeeId])
  @@map("employee_deductions")
}

model EmployeeEarning {
  id         String      @id @default(uuid())
  employeeId String
  type       EarningType // BONUS | ALLOWANCE | OTHER only (OVERTIME and HOLIDAY_PAY are auto-computed)
  label      String      // e.g., "Transportation Allowance"
  amount     Decimal     @db.Decimal(12, 2)

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId])
  @@map("employee_earnings")
}

// ============================================================================
// PUBLIC HOLIDAYS
// ============================================================================

model PublicHoliday {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  name        String
  type        String   // "REGULAR" | "SPECIAL_NON_WORKING"
  amount      Decimal  @db.Decimal(12, 2) @default(0) // fixed peso amount (used when percentage is null)
  percentage  Decimal? @db.Decimal(6, 2)              // % of daily rate (overrides amount when set, e.g. 100 = 100%)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("public_holidays")
}

// ============================================================================
// AUDIT LOGS
// ============================================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     // null for system-generated actions
  action     AuditAction
  tableName  String      // which table was affected
  recordId   String      // PK of the affected record
  oldValues  Json?       // snapshot before change
  newValues  Json?       // snapshot after change
  ipAddress  String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
